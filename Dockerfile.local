# Downstream application layer. Build and test source with build.sh first.
# Keep the verified tool/browser/CA base; never replace it with upstream latest.
ARG BASE=pojun-local/pojun:0.4.47-sapper-collab-20261105
FROM ${BASE}
ARG SOURCE_REVISION
ARG UPSTREAM_REVISION=234dd89a52eebc0dc84fce121e5456f2748fcaa3
ARG LOCAL_PATCH=downstream-20261105
COPY --chmod=0755 dist/amd64/pojun /app/pojun
LABEL org.opencontainers.image.source="https://github.com/jkl2825/Pojun-custom" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      local.pojun.upstream="${UPSTREAM_REVISION}" \
      local.pojun.patch="${LOCAL_PATCH}"
